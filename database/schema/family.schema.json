{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "family.schema.json",
  "title": "ProductFamily",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider_id",
    "name",
    "category",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "cpu_class": {
      "type": "string"
    },
    "storage_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "retired",
        "paused"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
